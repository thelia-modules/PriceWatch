{# Progress bar of the running pass, refreshed every few seconds until the
   pass ends. Included only while a pass runs. #}
<div class="{{ class|default('') }}" data-pw-progress="{{ path('pricewatch_run_progress', withItems|default(false) ? {items: 1} : {}) }}" data-testid="pw-progress">
    {% include '@PriceWatchModule/backOffice/default-twig/price-watch/_progress_body.html.twig' with {progress: progress, withItems: withItems|default(false)} only %}
</div>
<script>
    (function () {
        // Several blocks of one page share one poll.
        if (window.pricewatchProgress) {
            return;
        }
        window.pricewatchProgress = true;

        const POLL_MS = 3000;
        const MAX_FAILURES = 10;
        let idle = 0;
        let failures = 0;

        const boxes = () => document.querySelectorAll('[data-pw-progress]');

        function tick() {
            document.querySelectorAll('[data-pw-elapsed]').forEach((element) => {
                const seconds = Math.max(0, Math.floor(Date.now() / 1000) - Number(element.dataset.pwElapsed));
                const time = seconds >= 60
                    ? Math.floor(seconds / 60) + ' min ' + String(seconds % 60).padStart(2, '0') + ' s'
                    : seconds + ' s';
                element.textContent = element.dataset.pwElapsedFormat.replace('%time%', time);
            });
        }

        async function poll() {
            // One request per kind of bar: with or without the product list.
            const urls = [...new Set(Array.from(boxes(), (box) => box.dataset.pwProgress))];

            if (urls.length === 0) {
                return;
            }

            try {
                const answers = await Promise.all(urls.map(async (url) => {
                    const response = await fetch(url, {
                        headers: { Accept: 'application/json' },
                        credentials: 'same-origin',
                        cache: 'no-store',
                    });

                    if (!response.ok) {
                        throw new Error(String(response.status));
                    }

                    return response.json();
                }));
                const running = answers.some((data) => data.running);
                failures = 0;
                // Between the collect pass and the judge pass, no lock is held
                // for an instant: two idle answers in a row mean the run is over.
                idle = running ? 0 : idle + 1;

                if (running || idle >= 2) {
                    boxes().forEach((box) => {
                        box.innerHTML = answers[urls.indexOf(box.dataset.pwProgress)].html;
                    });
                    tick();
                }

                if (idle >= 2) {
                    document.querySelectorAll('[data-pw-running]').forEach((badge) => badge.remove());

                    return;
                }
            } catch (error) {
                if (++failures >= MAX_FAILURES) {
                    return;
                }
            }

            window.setTimeout(poll, POLL_MS);
        }

        document.addEventListener('click', (event) => {
            if (event.target.closest('[data-pw-reload]')) {
                window.location.reload();
            }
        });

        tick();
        window.setInterval(tick, 1000);
        window.setTimeout(poll, POLL_MS);
    })();
</script>
