{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Competitors'|trans({}, 'pricewatch') }}{% endblock %}
{% block body_testid %}pricewatch-competitors{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans({}, 'pricewatch') }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.module.configure', {module_code: 'PriceWatch'}) }}">{{ 'Price watch'|trans({}, 'pricewatch') }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Competitors'|trans({}, 'pricewatch') }}</li>
        </ol>
    </nav>
{% endblock %}

{% macro status_form(competitor, status, label, style, csrfToken) %}
    <form method="post" action="{{ path('pricewatch_competitors_status', {id: competitor.id}) }}" class="d-inline">
        <input type="hidden" name="_token" value="{{ csrfToken }}">
        <input type="hidden" name="status" value="{{ status }}">
        <button type="submit" class="btn btn-sm {{ style }}" data-testid="pw-{{ status }}-{{ competitor.id }}">{{ label }}</button>
    </form>
{% endmacro %}

{% macro identity(competitor) %}
    <a href="https://{{ competitor.domain }}" target="_blank" rel="noopener noreferrer nofollow" class="fw-semibold">{{ competitor.domain }}</a>
    {% if competitor.name %}<div class="text-muted small">{{ competitor.name }}</div>{% endif %}
{% endmacro %}

{% macro decision(competitor) %}
    {% if competitor.decidedBy %}<div class="small text-muted">{{ competitor.decidedBy }}, {{ competitor.decidedAt }}</div>{% endif %}
{% endmacro %}

{% macro source_label(source) %}
    {% if source == 'llm' %}{{ 'Suggested by the model'|trans({}, 'pricewatch') }}
    {% elseif source == 'import' %}{{ 'Reference file'|trans({}, 'pricewatch') }}
    {% elseif source == 'manual' %}{{ 'Added by hand'|trans({}, 'pricewatch') }}
    {% else %}{{ source }}{% endif %}
{% endmacro %}

{% block content %}
<div class="container-fluid" data-testid="pricewatch-competitors-page">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
        <div>
            <h1 class="h3 mb-1">{{ 'Competitors'|trans({}, 'pricewatch') }}</h1>
            <p class="text-muted mb-0">{{ 'Only the whitelist is compared. The blacklist is never compared and never suggested again.'|trans({}, 'pricewatch') }}</p>
        </div>
        <div class="d-flex gap-2">
            <form method="post" action="{{ path('pricewatch_competitors_suggest') }}">
                <input type="hidden" name="_token" value="{{ csrfToken }}">
                <button type="submit" class="btn btn-primary" data-testid="pw-suggest" {% if not llmReady %}disabled{% endif %}>
                    <i class="bi bi-stars me-1" aria-hidden="true"></i>{{ 'Suggest competitors'|trans({}, 'pricewatch') }}
                </button>
            </form>
            <a class="btn btn-outline-secondary" href="{{ path('admin.module.configure', {module_code: 'PriceWatch'}) }}">{{ 'Settings'|trans({}, 'pricewatch') }}</a>
        </div>
    </div>

    {% if not llmReady %}
        <div class="alert alert-info" data-testid="pw-llm-not-ready">
            {{ 'To get suggestions, set an OpenRouter key and choose a model in the settings. You can add competitors by hand meanwhile.'|trans({}, 'pricewatch') }}
        </div>
    {% else %}
        <p class="small text-muted">
            {{ 'Model:'|trans({}, 'pricewatch') }} <span class="font-monospace">{{ llmModel }}</span>,
            {{ webSearch ? 'with web search'|trans({}, 'pricewatch') : 'without web search'|trans({}, 'pricewatch') }}.
            {{ 'A suggestion can take a minute or two.'|trans({}, 'pricewatch') }}
        </p>
    {% endif %}

    <div class="card mb-4">
        <div class="card-body">
            <form method="post" action="{{ path('pricewatch_competitors_add') }}" class="row g-2 align-items-end">
                <input type="hidden" name="_token" value="{{ csrfToken }}">
                <div class="col-12 col-md-6">
                    <label class="form-label fw-semibold" for="pw-add-domain">{{ 'Add a competitor'|trans({}, 'pricewatch') }}</label>
                    <input type="text" class="form-control" id="pw-add-domain" name="domain" placeholder="exemple.fr" required spellcheck="false" autocomplete="off">
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                    <label class="form-label fw-semibold" for="pw-add-list">{{ 'List'|trans({}, 'pricewatch') }}</label>
                    <select class="form-select" id="pw-add-list" name="list">
                        <option value="watched">{{ 'Whitelist: compared'|trans({}, 'pricewatch') }}</option>
                        <option value="rejected">{{ 'Blacklist: excluded'|trans({}, 'pricewatch') }}</option>
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                    <button type="submit" class="btn btn-outline-primary w-100" data-testid="pw-add">{{ 'Add'|trans({}, 'pricewatch') }}</button>
                </div>
            </form>
        </div>
    </div>

    <section class="mb-4" data-testid="pw-proposed">
        <h2 class="h5">{{ 'To arbitrate'|trans({}, 'pricewatch') }} <span class="badge text-bg-warning">{{ proposed|length }}</span></h2>
        {% if proposed is empty %}
            <p class="text-muted">{{ 'No proposal waiting.'|trans({}, 'pricewatch') }}</p>
        {% else %}
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead><tr>
                        <th scope="col">{{ 'Competitor'|trans({}, 'pricewatch') }}</th>
                        <th scope="col">{{ 'Why'|trans({}, 'pricewatch') }}</th>
                        <th scope="col">{{ 'Origin'|trans({}, 'pricewatch') }}</th>
                        <th scope="col" class="text-end">{{ 'Decision'|trans({}, 'pricewatch') }}</th>
                    </tr></thead>
                    <tbody>
                    {% for competitor in proposed %}
                        <tr data-testid="pw-row-{{ competitor.domain }}">
                            <td>{{ _self.identity(competitor) }}</td>
                            <td class="small">
                                {{ competitor.reason ?: '' }}
                                {% if competitor.sources is not empty %}
                                    <div class="mt-1">
                                        {% for source in competitor.sources %}
                                            <a href="{{ source.url }}" target="_blank" rel="noopener noreferrer nofollow" class="me-2">{{ source.title ?: source.url|slice(0, 60) }}</a>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </td>
                            <td class="small text-muted">{{ _self.source_label(competitor.source) }}<div>{{ competitor.createdAt }}</div></td>
                            <td class="text-end text-nowrap">
                                {{ _self.status_form(competitor, 'watched', 'Compare'|trans({}, 'pricewatch'), 'btn-success', csrfToken) }}
                                {{ _self.status_form(competitor, 'rejected', 'Exclude'|trans({}, 'pricewatch'), 'btn-outline-danger', csrfToken) }}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>

    <div class="row g-4">
        <section class="col-12 col-xl-6" data-testid="pw-whitelist">
            <h2 class="h5">{{ 'Whitelist: compared'|trans({}, 'pricewatch') }} <span class="badge text-bg-success">{{ whitelist|length }}</span></h2>
            {% if whitelist is empty %}
                <p class="text-muted">{{ 'No competitor is compared yet.'|trans({}, 'pricewatch') }}</p>
            {% else %}
                <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <tbody>
                    {% for competitor in whitelist %}
                        <tr data-testid="pw-row-{{ competitor.domain }}">
                            <td class="text-break">
                                {{ _self.identity(competitor) }}
                                {% if competitor.status == 'paused' %}<span class="badge text-bg-secondary">{{ 'Paused'|trans({}, 'pricewatch') }}</span>{% endif %}
                                {{ _self.decision(competitor) }}
                            </td>
                            <td class="text-end text-nowrap">{{ _self.status_form(competitor, 'rejected', 'Exclude'|trans({}, 'pricewatch'), 'btn-outline-danger', csrfToken) }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
                </div>
            {% endif %}
        </section>

        <section class="col-12 col-xl-6" data-testid="pw-blacklist">
            <h2 class="h5">{{ 'Blacklist: excluded'|trans({}, 'pricewatch') }} <span class="badge text-bg-secondary">{{ blacklist|length }}</span></h2>
            {% if blacklist is empty %}
                <p class="text-muted">{{ 'No competitor is excluded.'|trans({}, 'pricewatch') }}</p>
            {% else %}
                <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <tbody>
                    {% for competitor in blacklist %}
                        <tr data-testid="pw-row-{{ competitor.domain }}">
                            <td class="text-break">{{ _self.identity(competitor) }}{{ _self.decision(competitor) }}</td>
                            <td class="text-end text-nowrap">
                                {{ _self.status_form(competitor, 'watched', 'Compare'|trans({}, 'pricewatch'), 'btn-outline-success', csrfToken) }}
                                {% if competitor.deletable %}
                                    <form method="post" action="{{ path('pricewatch_competitors_delete', {id: competitor.id}) }}" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrfToken }}">
                                        <button type="submit" class="btn btn-sm btn-link text-danger" data-testid="pw-delete-{{ competitor.id }}"
                                                title="{{ 'Removes it from the blacklist: it may be suggested again.'|trans({}, 'pricewatch') }}">{{ 'Delete'|trans({}, 'pricewatch') }}</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
                </div>
            {% endif %}
        </section>
    </div>
</div>
{% endblock %}
