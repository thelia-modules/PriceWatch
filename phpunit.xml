<?xml version="1.0" encoding="UTF-8"?>
<!-- Lives in the module so the project's phpunit.xml.dist stays untouched.
     Run from the project root:
       ddev exec vendor/bin/phpunit -c local/modules/PriceWatch/phpunit.xml

     APP_ENV stays dev: the test environment has neither its Propel models
     generated (var/propel/test) nor the core console commands, so the
     integration suite boots the development kernel and isolates itself with a
     transaction rolled back after each test. See
     Tests/Integration/PriceWatchIntegrationTestCase.

     Never run bin/test-prepare against this install: it calls
     createDatabase() on DATABASE_NAME, which here is the development
     database. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../../../vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="Tests/bootstrap.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <testsuite name="PriceWatch unit">
            <directory>Tests/Unit</directory>
        </testsuite>
        <testsuite name="PriceWatch integration">
            <directory>Tests/Integration</directory>
        </testsuite>
    </testsuites>
    <php>
        <server name="APP_ENV" value="dev"/>
        <server name="APP_DEBUG" value="0"/>
    </php>
</phpunit>
