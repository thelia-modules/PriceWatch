{% macro watch_form(route, params, label, style, csrfToken, testid, icon) %}
    <form method="post" action="{{ path(route, params) }}" class="d-inline">
        <input type="hidden" name="_token" value="{{ csrfToken }}">
        <button type="submit" class="btn btn-sm {{ style }}" data-testid="{{ testid }}">{% if icon %}<i class="bi {{ icon }} me-1" aria-hidden="true"></i>{% endif %}{{ label }}</button>
    </form>
{% endmacro %}

<div data-testid="pricewatch-product-card">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <h3 class="h6 mb-0">
            {{ 'Price watch'|trans({}, 'pricewatch') }}
            {% if inReferential %}
                {% if watch.monitored > 0 %}<span class="badge bg-success-subtle text-success-emphasis border border-success-subtle ms-1" data-testid="pw-card-status">{{ 'Watched'|trans({}, 'pricewatch') }}</span>
                {% else %}<span class="badge bg-body-secondary text-body border ms-1" data-testid="pw-card-status">{{ 'Paused'|trans({}, 'pricewatch') }}</span>{% endif %}
            {% endif %}
        </h3>
        {% if canChange %}
            <div class="d-flex flex-wrap gap-1">
                {% if not inReferential or watch.missing > 0 %}
                    {{ _self.watch_form('pricewatch_product_enrol', {productId: productId},
                        inReferential ? ('Add the %count% missing variant(s)'|trans({'%count%': watch.missing}, 'pricewatch')) : ('Add to the price watch'|trans({}, 'pricewatch')),
                        'btn-primary', csrfToken, 'pw-card-enrol', 'bi-plus-circle') }}
                {% endif %}
                {% if inReferential and watch.collectable > 0 %}
                    {% if run.running %}
                        <span data-pw-running class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle align-self-center" data-testid="pw-card-running">{{ 'A pass is running'|trans({}, 'pricewatch') }}</span>
                    {% else %}
                        {{ _self.watch_form('pricewatch_product_collect', {productId: productId}, 'Collect now (at most %cost%)'|trans({'%cost%': collectCost}, 'pricewatch'), 'btn-primary', csrfToken, 'pw-card-collect', 'bi-arrow-repeat') }}
                    {% endif %}
                {% endif %}
                {% if inReferential and watch.paused > 0 %}
                    {{ _self.watch_form('pricewatch_product_monitoring', {productId: productId, action: 'resume'}, 'Resume the watch'|trans({}, 'pricewatch'), 'btn-outline-success', csrfToken, 'pw-card-resume', 'bi-play-circle') }}
                {% endif %}
                {% if inReferential and watch.monitored > 0 %}
                    {{ _self.watch_form('pricewatch_product_monitoring', {productId: productId, action: 'pause'}, 'Pause the watch'|trans({}, 'pricewatch'), 'btn-outline-secondary', csrfToken, 'pw-card-pause', 'bi-pause-circle') }}
                {% endif %}
            </div>
        {% endif %}
    </div>
    {% if run.running %}
        {% include '@PriceWatchModule/backOffice/default-twig/price-watch/_progress.html.twig' with {progress: run.progress, class: 'mb-3'} only %}
    {% endif %}
    {% if not inReferential %}
        <p class="text-muted mb-0" data-testid="pw-card-empty">
            {{ 'This product is not in the price watch referential: no competitor price is collected for it.'|trans({}, 'pricewatch') }}
            {% if canChange %}{{ 'Adding it reads its variants, EAN codes and sizes from the catalogue; prices are collected at the next pass.'|trans({}, 'pricewatch') }}{% endif %}
        </p>
    {% else %}
        {% if watch.notCollectable > 0 %}
            <div class="alert alert-warning py-2 small" data-testid="pw-card-not-collectable">
                {{ '%count% watched variant(s) have no valid GTIN of their own: Google Shopping is searched by GTIN, so they are not collected. Fill in their EAN code in the catalogue, then add the product again.'|trans({'%count%': watch.notCollectable}, 'pricewatch') }}
            </div>
        {% endif %}
        {% if watch.monitored > 0 and lastWatch and lastWatch.stale %}
            <div class="alert alert-warning py-2 small" data-testid="pw-card-stale">
                {{ 'card.stale'|trans({'%at%': lastWatch.at, '%days%': lastWatch.daysAgo}, 'pricewatch') }}
            </div>
        {% else %}
            <p class="small text-muted mb-1" data-testid="pw-card-last-watch">
                {% if lastWatch %}
                    {{ 'card.last_watch'|trans({'%at%': lastWatch.at, '%ago%': 'watched.days_ago'|trans({'%count%': lastWatch.daysAgo}, 'pricewatch')}, 'pricewatch') }}
                {% else %}
                    {{ 'card.never_watched'|trans({}, 'pricewatch') }}
                {% endif %}
            </p>
        {% endif %}
        <p class="mb-2">
            {{ '%compared% offer(s) compared, %dearer% where we are dearer, %review% waiting for your review.'|trans({'%compared%': totals.compared, '%dearer%': totals.weAreDearer, '%review%': totals.review}, 'pricewatch') }}
            <a href="{{ comparatorUrl }}" class="ms-1">{{ 'Open in the comparator'|trans({}, 'pricewatch') }}</a>
            {% if totals.review > 0 %}· <a href="{{ reviewUrl }}">{{ 'Review'|trans({}, 'pricewatch') }}</a>{% endif %}
        </p>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">{{ 'Variant'|trans({}, 'pricewatch') }}</th>
                        <th scope="col">GTIN</th>
                        <th scope="col" class="text-end">{{ 'Offers compared'|trans({}, 'pricewatch') }}</th>
                        <th scope="col">{{ 'Best gap'|trans({}, 'pricewatch') }}</th>
                        <th scope="col" class="text-end">{{ 'To review'|trans({}, 'pricewatch') }}</th>
                        <th scope="col" class="text-end">{{ 'Watch'|trans({}, 'pricewatch') }}</th>
                    </tr>
                </thead>
                <tbody>
                {% for variant in variants %}
                    <tr>
                        <td>
                            {{ variant.size ?: '–' }}{% if variant.color %} · {{ variant.color }}{% endif %}
                            <div class="small text-muted">{{ variant.ref }}{% if variant.monitored and not variant.collectable %} · <span class="text-warning-emphasis">{{ 'not collected: no GTIN of its own'|trans({}, 'pricewatch') }}</span>{% endif %}</div>
                        </td>
                        <td class="text-nowrap">
                            {% if variant.gtin %}
                                <span class="font-monospace">{{ variant.gtin }}</span>
                                {% if not variant.gtinValid %}<span class="badge text-bg-secondary">{{ 'invalid'|trans({}, 'pricewatch') }}</span>
                                {% elseif variant.gtinShared %}<span class="badge text-bg-warning">{{ 'shared'|trans({}, 'pricewatch') }}</span>{% endif %}
                            {% else %}<span class="text-muted">{{ 'none'|trans({}, 'pricewatch') }}</span>{% endif %}
                        </td>
                        <td class="text-end">{{ variant.compared }}</td>
                        <td>
                            {% if variant.best %}
                                {% include '@PriceWatchModule/backOffice/default-twig/price-watch/_gap.html.twig' with {position: variant.best.position, pct: variant.best.gap} only %}
                                <span class="small text-muted ms-1">{{ variant.best.competitor }}</span>
                            {% else %}<span class="text-muted">–</span>{% endif %}
                        </td>
                        <td class="text-end">{{ variant.review ?: '' }}</td>
                        <td class="text-end text-nowrap">
                            {% if variant.monitored %}
                                <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">{{ 'Watched'|trans({}, 'pricewatch') }}</span>
                                {% if canChange %}{{ _self.watch_form('pricewatch_product_monitoring', {productId: productId, action: 'pause', saleElementId: variant.saleElementId}, 'Pause'|trans({}, 'pricewatch'), 'btn-link py-0', csrfToken, 'pw-variant-pause-' ~ variant.saleElementId, null) }}{% endif %}
                            {% else %}
                                <span class="badge bg-body-secondary text-body border">{{ 'Paused'|trans({}, 'pricewatch') }}</span>
                                {% if canChange %}{{ _self.watch_form('pricewatch_product_monitoring', {productId: productId, action: 'resume', saleElementId: variant.saleElementId}, 'Resume'|trans({}, 'pricewatch'), 'btn-link py-0', csrfToken, 'pw-variant-resume-' ~ variant.saleElementId, null) }}{% endif %}
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
