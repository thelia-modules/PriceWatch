{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Price comparator'|trans({}, 'pricewatch') }}{% endblock %}
{% block body_testid %}pricewatch-comparator{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans({}, 'pricewatch') }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.module.configure', {module_code: 'PriceWatch'}) }}">{{ 'Price watch'|trans({}, 'pricewatch') }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Price comparator'|trans({}, 'pricewatch') }}</li>
        </ol>
    </nav>
{% endblock %}

{% macro state_badge(row) %}
    {% set styles = {
        matched_exact: 'text-bg-success', matched_judged: 'text-bg-success', matched_manual: 'text-bg-success',
        needs_review: 'text-bg-warning', candidate: 'text-bg-light border', rejected: 'text-bg-secondary'
    } %}
    <span class="badge {{ styles[row.state] ?? 'text-bg-light border' }}" data-testid="pw-state-{{ row.id }}">{{ ('state.' ~ row.state)|trans({}, 'pricewatch') }}</span>
    {% if row.method == 'human' and row.reviewedBy %}
        <div class="small text-muted mt-1">{{ row.reviewedBy }}, {{ row.reviewedAt }}</div>
    {% elseif row.reason %}
        <div class="small text-muted mt-1">{{ ('reason.' ~ row.reason)|trans({}, 'pricewatch') }}</div>
    {% endif %}
    {% if row.exclusion and row.state != 'rejected' %}<div class="small text-muted">{{ ('exclusion.' ~ row.exclusion)|trans({}, 'pricewatch') }}</div>{% endif %}
{% endmacro %}

{# How far the match can be trusted: a level, then one gauge per Jev
   question, coloured by its band. The level is the weakest gauge. #}
{% macro confidence(row) %}
    {% set levels = {
        high: 'bg-success-subtle text-success-emphasis border-success-subtle',
        medium: 'bg-warning-subtle text-warning-emphasis border-warning-subtle',
        low: 'bg-danger-subtle text-danger-emphasis border-danger-subtle',
        human: 'bg-primary-subtle text-primary-emphasis border-primary-subtle',
        rule: 'bg-body-secondary text-body border',
        none: 'bg-body-tertiary text-muted border'
    } %}
    {% set bands = {yes: 'bg-success', act: 'bg-success', review: 'bg-warning', no: 'bg-danger'} %}
    <div class="mt-2" data-testid="pw-confidence-{{ row.id }}" data-level="{{ row.confidence.level }}">
        <span class="badge border {{ levels[row.confidence.level] ?? levels.none }}">
            {{ ('confidence.' ~ row.confidence.level)|trans({}, 'pricewatch') }}{% if row.confidence.score is not null and row.confidence.level in ['high', 'medium', 'low'] %} · {{ row.confidence.score }} %{% endif %}
        </span>
        {% if row.confidence.disagreements is not empty %}
            <div class="small text-danger-emphasis mt-1" data-testid="pw-disagreement-{{ row.id }}">
                <i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i>{{ 'Jev disagrees on:'|trans({}, 'pricewatch') }}
                {% for question in row.confidence.disagreements %}{{ ('gauge.' ~ question)|trans({}, 'pricewatch')|lower }}{% if not loop.last %}, {% endif %}{% endfor %}
            </div>
        {% endif %}
        {% if row.searchedBy %}
            <span class="badge border bg-body-tertiary text-body" title="{{ ('searched_by.' ~ row.searchedBy)|trans({}, 'pricewatch') }}">{{ ('found_by.' ~ row.searchedBy)|trans({}, 'pricewatch') }}</span>
        {% endif %}
        {% for gauge in row.confidence.gauges %}
            <div class="d-flex align-items-center gap-2 mt-1 small" title="{{ ('jev.' ~ gauge.question)|trans({}, 'pricewatch') }}{% if gauge.choice %} : {{ ('price.' ~ gauge.choice)|trans({}, 'pricewatch') }}{% endif %}">
                <span class="text-muted text-nowrap" style="width: 3.6rem">{{ ('gauge.' ~ gauge.question)|trans({}, 'pricewatch') }}</span>
                <div class="progress flex-grow-1" style="height: .4rem" role="progressbar" aria-valuenow="{{ gauge.percent }}" aria-valuemin="0" aria-valuemax="100" aria-label="{{ ('jev.' ~ gauge.question)|trans({}, 'pricewatch') }}">
                    <div class="progress-bar {{ bands[gauge.band] ?? 'bg-secondary' }}" style="width: {{ gauge.percent }}%"></div>
                </div>
                <span class="text-nowrap" style="width: 2.4rem; text-align: right">{{ gauge.percent }} %</span>
            </div>
        {% endfor %}
    </div>
{% endmacro %}

{% macro review_form(row, action, label, style, csrfToken, returnQuery) %}
    <form method="post" action="{{ path('pricewatch_comparator_review', {id: row.id, action: action}) }}" class="d-inline">
        <input type="hidden" name="_token" value="{{ csrfToken }}">
        <input type="hidden" name="return" value="{{ returnQuery }}">
        <button type="submit" class="btn btn-sm {{ style }}" data-testid="pw-{{ action }}-{{ row.id }}">{{ label }}</button>
    </form>
{% endmacro %}

{% block content %}
<div class="container-fluid" data-testid="pricewatch-comparator-page">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
        <div>
            <h1 class="h3 mb-1">{{ 'Price comparator'|trans({}, 'pricewatch') }}</h1>
            <p class="text-muted mb-0">{{ 'Our prices against whitelisted competitors, for the same product in the same size. Prices include tax, shipping excluded.'|trans({}, 'pricewatch') }}</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" href="{{ path('pricewatch_competitors') }}">{{ 'Competitors'|trans({}, 'pricewatch') }}</a>
            <a class="btn btn-outline-secondary" href="{{ path('admin.module.configure', {module_code: 'PriceWatch'}) }}">{{ 'Settings'|trans({}, 'pricewatch') }}</a>
        </div>
    </div>

    <div class="row g-3 mb-3" data-testid="pw-summary">
        <div class="col-6 col-lg">
            <div class="card h-100"><div class="card-body py-2">
                <div class="small text-muted">{{ 'Offers compared'|trans({}, 'pricewatch') }}</div>
                <div class="fs-4 fw-semibold">{{ summary.compared }}</div>
            </div></div>
        </div>
        <div class="col-6 col-lg">
            <div class="card h-100 border-success-subtle"><div class="card-body py-2">
                <div class="small text-muted">{{ 'We are cheaper'|trans({}, 'pricewatch') }}</div>
                <div class="fs-4 fw-semibold text-success-emphasis" data-testid="pw-summary-we-are-cheaper">{{ summary.weAreCheaper }}</div>
            </div></div>
        </div>
        <div class="col-6 col-lg">
            <div class="card h-100 border-danger-subtle"><div class="card-body py-2">
                <div class="small text-muted">{{ 'We are dearer'|trans({}, 'pricewatch') }}</div>
                <div class="fs-4 fw-semibold text-danger-emphasis" data-testid="pw-summary-we-are-dearer">{{ summary.weAreDearer }}</div>
            </div></div>
        </div>
        <div class="col-6 col-lg">
            <div class="card h-100"><div class="card-body py-2">
                <div class="small text-muted">{{ 'Average gap'|trans({}, 'pricewatch') }}</div>
                <div class="fs-4 fw-semibold {{ summary.averagePosition == 'cheaper' ? 'text-success-emphasis' : (summary.averagePosition == 'dearer' ? 'text-danger-emphasis' : '') }}">{{ summary.averagePct ?? '–' }}</div>
            </div></div>
        </div>
        <div class="col-12 col-lg">
            <a class="card h-100 text-decoration-none {{ counts.review > 0 ? 'border-warning' : '' }}" href="{{ tabs[1].url }}" data-testid="pw-summary-review">
                <div class="card-body py-2">
                    <div class="small text-muted">{{ 'Waiting for your review'|trans({}, 'pricewatch') }}</div>
                    <div class="fs-4 fw-semibold text-body">{{ counts.review }}</div>
                </div>
            </a>
        </div>
    </div>

    <form method="get" action="{{ path('pricewatch_comparator') }}" class="row g-2 align-items-end mb-3" data-testid="pw-filters">
        <input type="hidden" name="view" value="{{ view }}">
        <div class="col-12 col-md-4">
            <label class="form-label small fw-semibold" for="pw-q">{{ 'Product'|trans({}, 'pricewatch') }}</label>
            <input type="search" class="form-control form-control-sm" id="pw-q" name="q" value="{{ filters.search }}" placeholder="{{ 'Name or reference'|trans({}, 'pricewatch') }}">
        </div>
        <div class="col-12 col-sm-6 col-md-3">
            <label class="form-label small fw-semibold" for="pw-competitor">{{ 'Competitor'|trans({}, 'pricewatch') }}</label>
            <select class="form-select form-select-sm" id="pw-competitor" name="competitor">
                <option value="">{{ 'All whitelisted competitors'|trans({}, 'pricewatch') }}</option>
                {% for id, domain in competitors %}
                    <option value="{{ id }}" {% if filters.competitorId == id %}selected{% endif %}>{{ domain }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-12 col-sm-6 col-md-3">
            <div class="form-check mb-1">
                <input class="form-check-input" type="checkbox" id="pw-cheaper" name="cheaper" value="1" {% if filters.cheaperOnly %}checked{% endif %}>
                <label class="form-check-label small" for="pw-cheaper">{{ 'Only where we are dearer'|trans({}, 'pricewatch') }}</label>
            </div>
        </div>
        <div class="col-12 col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-sm btn-primary flex-grow-1">{{ 'Filter'|trans({}, 'pricewatch') }}</button>
            <a class="btn btn-sm btn-outline-secondary" href="{{ path('pricewatch_comparator', {view: view}) }}">{{ 'Reset'|trans({}, 'pricewatch') }}</a>
        </div>
    </form>

    <ul class="nav nav-tabs mb-3" data-testid="pw-tabs">
        {% for tab in tabs %}
            <li class="nav-item">
                <a class="nav-link {{ tab.active ? 'active' : '' }}" {% if tab.active %}aria-current="page"{% endif %} href="{{ tab.url }}" data-testid="pw-tab-{{ tab.view }}">
                    {{ ('view.' ~ tab.view)|trans({}, 'pricewatch') }}
                    <span class="badge {{ tab.view == 'review' and tab.count > 0 ? 'text-bg-warning' : 'text-bg-light border' }} ms-1">{{ tab.count }}</span>
                </a>
            </li>
        {% endfor %}
    </ul>

    <p class="small text-muted">{{ ('view.' ~ view ~ '.help')|trans({}, 'pricewatch') }}</p>

    {% if rows is empty %}
        <div class="alert alert-light border" data-testid="pw-empty">
            {% if competitors is empty %}
                {{ 'No competitor is whitelisted: nothing is compared yet.'|trans({}, 'pricewatch') }}
                <a href="{{ path('pricewatch_competitors') }}">{{ 'Manage competitors'|trans({}, 'pricewatch') }}</a>
            {% else %}
                {{ ('view.' ~ view ~ '.empty')|trans({}, 'pricewatch') }}
            {% endif %}
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-sm align-middle" data-testid="pw-offers">
                <thead>
                    <tr>
                        <th scope="col">{{ 'Product'|trans({}, 'pricewatch') }}</th>
                        <th scope="col">{{ 'Competitor offer'|trans({}, 'pricewatch') }}</th>
                        <th scope="col" class="text-end">{{ 'Their price'|trans({}, 'pricewatch') }}</th>
                        <th scope="col" class="text-end">{{ 'Our price'|trans({}, 'pricewatch') }}</th>
                        <th scope="col" class="text-end">{{ 'Gap'|trans({}, 'pricewatch') }}</th>
                        <th scope="col">{{ 'Check and confidence'|trans({}, 'pricewatch') }}</th>
                        <th scope="col" class="text-end">{{ 'Decision'|trans({}, 'pricewatch') }}</th>
                    </tr>
                </thead>
                <tbody>
                {% for row in rows %}
                    <tr data-testid="pw-offer-{{ row.id }}">
                        <td class="text-break" style="min-width: 11rem; max-width: 16rem; white-space: normal">
                            {% if row.product.editUrl %}<a href="{{ row.product.editUrl }}" class="fw-semibold">{{ row.product.title }}</a>{% else %}<span class="fw-semibold">{{ row.product.title }}</span>{% endif %}
                            <div class="small text-muted">
                                {{ row.product.ref }}
                                {% if row.product.size %} · {{ 'Size'|trans({}, 'pricewatch') }} <strong>{{ row.product.size }}</strong>{% endif %}
                            </div>
                        </td>
                        <td class="text-break" style="min-width: 14rem; max-width: 18rem; white-space: normal">
                            <div class="d-flex gap-2">
                                {% if row.image %}
                                    <img src="{{ row.image }}" alt="" width="48" height="48" loading="lazy" referrerpolicy="no-referrer" class="rounded border flex-shrink-0" style="object-fit: contain; background: #fff" data-testid="pw-image-{{ row.id }}">
                                {% endif %}
                                <div>
                                    <div class="fw-semibold">{{ row.competitor }}</div>
                                    <div class="small">{{ row.remoteVariant ?: row.remoteTitle }}</div>
                                </div>
                            </div>
                            <div class="d-flex flex-wrap gap-1 mt-1" data-testid="pw-links-{{ row.id }}">
                                {% if row.links.product %}
                                    <a class="btn btn-sm btn-outline-primary py-0" href="{{ row.links.product }}" target="_blank" rel="noopener noreferrer nofollow" data-testid="pw-link-product-{{ row.id }}"><i class="bi bi-box-arrow-up-right me-1" aria-hidden="true"></i>{{ 'See the product'|trans({}, 'pricewatch') }}</a>
                                {% elseif row.links.search %}
                                    <a class="btn btn-sm btn-outline-secondary py-0" href="{{ row.links.search }}" target="_blank" rel="noopener noreferrer nofollow" data-testid="pw-link-search-{{ row.id }}"><i class="bi bi-search me-1" aria-hidden="true"></i>{{ 'Search on the site'|trans({}, 'pricewatch') }}</a>
                                {% endif %}
                                {% if row.links.google %}
                                    <a class="btn btn-sm btn-outline-secondary py-0" href="{{ row.links.google }}" target="_blank" rel="noopener noreferrer nofollow" data-testid="pw-link-google-{{ row.id }}"><i class="bi bi-shop me-1" aria-hidden="true"></i>Google Shopping</a>
                                {% endif %}
                            </div>
                            <details class="small mt-1" data-testid="pw-proof-{{ row.id }}">
                                <summary class="text-primary">{{ 'Proof'|trans({}, 'pricewatch') }}</summary>
                                <dl class="row mb-0 mt-1">
                                    <dt class="col-5 fw-normal text-muted">{{ 'Google card'|trans({}, 'pricewatch') }}</dt>
                                    <dd class="col-7 mb-1">{{ row.remoteTitle }}</dd>
                                    <dt class="col-5 fw-normal text-muted">{{ 'Seller listing'|trans({}, 'pricewatch') }}</dt>
                                    <dd class="col-7 mb-1">{{ row.remoteVariant ?: '–' }}</dd>
                                    <dt class="col-5 fw-normal text-muted">{{ 'Competitor site'|trans({}, 'pricewatch') }}</dt>
                                    <dd class="col-7 mb-1">{% if row.links.site %}<a href="{{ row.links.site }}" target="_blank" rel="noopener noreferrer nofollow">{{ row.competitor }}</a>{% else %}–{% endif %}</dd>
                                    <dt class="col-5 fw-normal text-muted">{{ 'Product page'|trans({}, 'pricewatch') }}</dt>
                                    <dd class="col-7 mb-1">{{ row.links.product ? 'Given by Google Shopping'|trans({}, 'pricewatch') : 'Not given by Google Shopping for this seller'|trans({}, 'pricewatch') }}</dd>
                                    <dt class="col-5 fw-normal text-muted">{{ 'Found by'|trans({}, 'pricewatch') }}</dt>
                                    <dd class="col-7 mb-1">{{ row.searchedBy ? ('searched_by.' ~ row.searchedBy)|trans({}, 'pricewatch') : '–' }}</dd>
                                    {% for gauge in row.confidence.gauges %}
                                        <dt class="col-5 fw-normal text-muted">{{ ('jev.' ~ gauge.question)|trans({}, 'pricewatch') }}</dt>
                                        <dd class="col-7 mb-1">{% if gauge.choice %}{{ ('price.' ~ gauge.choice)|trans({}, 'pricewatch') }}, {% endif %}{{ gauge.percent }} % <span class="text-muted">({{ ('band.' ~ gauge.band)|trans({}, 'pricewatch') }})</span></dd>
                                    {% endfor %}
                                    {% if row.reviewedBy %}
                                        <dt class="col-5 fw-normal text-muted">{{ 'Decided by'|trans({}, 'pricewatch') }}</dt>
                                        <dd class="col-7 mb-1">{{ row.reviewedBy }}, {{ row.reviewedAt }}</dd>
                                    {% endif %}
                                    <dt class="col-5 fw-normal text-muted">{{ 'Last seen'|trans({}, 'pricewatch') }}</dt>
                                    <dd class="col-7 mb-0">{{ row.seenAt }}</dd>
                                </dl>
                            </details>
                        </td>
                        <td class="text-end text-nowrap">
                            {{ row.theirs ?? '–' }}
                            {% if row.shipping %}<div class="small text-muted">+ {{ row.shipping }} {{ 'shipping'|trans({}, 'pricewatch') }}</div>{% endif %}
                        </td>
                        <td class="text-end text-nowrap">{{ row.ours ?? '–' }}</td>
                        <td class="text-end" style="min-width: 7rem; max-width: 9rem; white-space: normal" data-testid="pw-gap-{{ row.id }}">
                            {% include '@PriceWatchModule/backOffice/default-twig/price-watch/_gap.html.twig' with {position: row.position, pct: row.deltaPct, amount: row.delta, with_label: true} only %}
                        </td>
                        <td style="min-width: 11rem; max-width: 14rem; white-space: normal">{{ _self.state_badge(row) }}{{ _self.confidence(row) }}</td>
                        <td>
                            <div class="d-flex flex-column align-items-end gap-1">
                            {% if row.actions.confirm %}{{ _self.review_form(row, 'confirm', 'Confirm'|trans({}, 'pricewatch'), 'btn-success', csrfToken, returnQuery) }}{% endif %}
                            {% if row.actions.reject %}{{ _self.review_form(row, 'reject', 'Exclude'|trans({}, 'pricewatch'), 'btn-outline-danger', csrfToken, returnQuery) }}{% endif %}
                            {% if row.actions.reopen and row.state != 'candidate' %}{{ _self.review_form(row, 'reopen', 'To review'|trans({}, 'pricewatch'), 'btn-link p-0', csrfToken, returnQuery) }}{% endif %}
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        {% if pagination.pages > 1 %}
            <nav class="d-flex justify-content-between align-items-center" aria-label="{{ 'Pages'|trans({}, 'pricewatch') }}">
                <span class="small text-muted">{{ 'Page %page% of %pages%'|trans({'%page%': pagination.page, '%pages%': pagination.pages}, 'pricewatch') }}</span>
                <div class="d-flex gap-2">
                    {% if pagination.previous %}<a class="btn btn-sm btn-outline-secondary" href="{{ pagination.previous }}">{{ 'Previous'|trans({}, 'pricewatch') }}</a>{% endif %}
                    {% if pagination.next %}<a class="btn btn-sm btn-outline-secondary" href="{{ pagination.next }}">{{ 'Next'|trans({}, 'pricewatch') }}</a>{% endif %}
                </div>
            </nav>
        {% endif %}
    {% endif %}
</div>
{% endblock %}
