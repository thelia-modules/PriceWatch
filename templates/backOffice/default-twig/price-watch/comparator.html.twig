{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Price comparator'|trans({}, 'pricewatch') }}{% endblock %}
{% block body_testid %}pricewatch-comparator{% endblock %}

{% block head_extra %}
    <style>
        /* The detail chevron turns when its row is open. */
        .pw-offers .pw-toggle i { display: inline-block; transition: transform .15s ease-in-out; }
        .pw-offers .pw-toggle[aria-expanded="true"] i { transform: rotate(180deg); }
        .pw-offers tr.pw-row { cursor: pointer; }
        .pw-offers tr.pw-detail > td { cursor: default; }
    </style>
{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans({}, 'pricewatch') }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.module.configure', {module_code: 'PriceWatch'}) }}">{{ 'Price watch'|trans({}, 'pricewatch') }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Price comparator'|trans({}, 'pricewatch') }}</li>
        </ol>
    </nav>
{% endblock %}

{# Who decided, and why the offer is where it is: shown in the detail, and
   in the line itself on the tabs where it is the point. #}
{% macro state(row) %}
    {% set styles = {
        matched_exact: 'text-bg-success', matched_judged: 'text-bg-success', matched_manual: 'text-bg-success',
        needs_review: 'text-bg-warning', candidate: 'text-bg-light border', rejected: 'text-bg-secondary'
    } %}
    <span class="badge {{ styles[row.state] ?? 'text-bg-light border' }}" data-testid="pw-state-{{ row.id }}">{{ ('state.' ~ row.state)|trans({}, 'pricewatch') }}</span>
    {% if row.method == 'human' and row.reviewedBy %}
        <span class="small text-muted ms-1">{{ row.reviewedBy }}, {{ row.reviewedAt }}</span>
    {% elseif row.reason %}
        <span class="small text-muted ms-1">{{ ('reason.' ~ row.reason)|trans({}, 'pricewatch') }}</span>
    {% endif %}
    {% if row.exclusion and row.state != 'rejected' %}<span class="small text-muted ms-1">· {{ ('exclusion.' ~ row.exclusion)|trans({}, 'pricewatch') }}</span>{% endif %}
{% endmacro %}

{# How far the match can be trusted, at a glance: one square per Jev
   question (product, size, price) coloured by its band, a person when a
   human decided, a warning when Jev disagrees with that human. #}
{% macro trust(row) %}
    {% set bands = {yes: 'text-bg-success', act: 'text-bg-success', review: 'text-bg-warning', no: 'text-bg-danger'} %}
    <div class="d-flex align-items-center gap-1 text-nowrap" data-testid="pw-confidence-{{ row.id }}" data-level="{{ row.confidence.level }}">
        {% if row.method == 'human' %}
            <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis border border-primary-subtle" data-bs-toggle="tooltip" title="{{ 'Confirmed by hand'|trans({}, 'pricewatch') }}{% if row.reviewedBy %} : {{ row.reviewedBy }}, {{ row.reviewedAt }}{% endif %}" aria-label="{{ 'confidence.human'|trans({}, 'pricewatch') }}"><i class="bi bi-person-check-fill" aria-hidden="true"></i></span>
        {% elseif row.method == 'code' %}
            <span class="badge rounded-pill bg-body-secondary text-body border" data-bs-toggle="tooltip" title="{{ 'confidence.rule'|trans({}, 'pricewatch') }}" aria-label="{{ 'confidence.rule'|trans({}, 'pricewatch') }}"><i class="bi bi-gear-fill" aria-hidden="true"></i></span>
        {% endif %}
        {% for gauge in row.confidence.gauges %}
            {% set label = ('gauge.' ~ gauge.question)|trans({}, 'pricewatch') ~ ' : ' ~ gauge.percent ~ ' % (' ~ ('band.' ~ gauge.band)|trans({}, 'pricewatch') ~ ')' %}
            <span class="badge {{ bands[gauge.band] ?? 'text-bg-secondary' }}" style="min-width: 1.6rem" data-band="{{ gauge.band }}" data-bs-toggle="tooltip" title="{{ label }}" aria-label="{{ label }}">{{ ('gauge.short.' ~ gauge.question)|trans({}, 'pricewatch') }}</span>
        {% endfor %}
        {% if row.confidence.disagreements is not empty %}
            {% set disagreement = 'Jev disagrees on:'|trans({}, 'pricewatch') ~ ' ' ~ row.confidence.disagreements|map(question => ('gauge.' ~ question)|trans({}, 'pricewatch')|lower)|join(', ') %}
            <i class="bi bi-exclamation-triangle-fill text-danger ms-1" data-bs-toggle="tooltip" title="{{ disagreement }}" aria-label="{{ disagreement }}" data-testid="pw-disagreement-{{ row.id }}"></i>
        {% endif %}
        {% if row.confidence.score is not null and row.confidence.level in ['high', 'medium', 'low'] %}
            <span class="small text-muted ms-1">{{ row.confidence.score }} %</span>
        {% elseif row.confidence.gauges is empty and row.method not in ['human', 'code'] %}
            <span class="small text-muted">{{ 'confidence.none'|trans({}, 'pricewatch') }}</span>
        {% endif %}
    </div>
{% endmacro %}

{# The gap in small, over a bar drawn from the middle: to the left in red
   when the competitor is cheaper, to the right in green when we are. #}
{% macro gap(row) %}
    {% set colours = {cheaper: 'text-success-emphasis', dearer: 'text-danger-emphasis', equal: 'text-body-secondary'} %}
    {% if row.deltaPct and row.bar %}
        <div class="d-inline-block text-center" style="width: 7rem">
        <div class="small fw-semibold lh-sm {{ colours[row.position] ?? 'text-body-secondary' }}">{{ row.deltaPct }}</div>
        <div class="position-relative rounded-pill bg-secondary-subtle mt-1" style="height: .5rem" role="img" aria-label="{{ ('position.' ~ row.position)|trans({}, 'pricewatch') }} ({{ row.deltaPct }})" data-bs-toggle="tooltip" title="{{ ('position.' ~ row.position)|trans({}, 'pricewatch') }}{% if row.delta %} : {{ row.delta }}{% endif %}">
            {% if row.bar.side == 'left' %}
                <span class="position-absolute top-0 bottom-0 rounded-pill bg-danger" style="right: 50%; width: {{ row.bar.width }}%"></span>
            {% elseif row.bar.side == 'right' %}
                <span class="position-absolute top-0 bottom-0 rounded-pill bg-success" style="left: 50%; width: {{ row.bar.width }}%"></span>
            {% endif %}
            <span class="position-absolute start-50 border-start border-secondary" style="top: -.2rem; bottom: -.2rem"></span>
        </div>
        </div>
    {% else %}
        <span class="text-muted">–</span>
    {% endif %}
{% endmacro %}

{% macro review_form(row, action, label, style, csrfToken, returnQuery, icon) %}
    <form method="post" action="{{ path('pricewatch_comparator_review', {id: row.id, action: action}) }}" class="d-inline">
        <input type="hidden" name="_token" value="{{ csrfToken }}">
        <input type="hidden" name="return" value="{{ returnQuery }}">
        <button type="submit" class="btn btn-sm {{ style }}" data-testid="pw-{{ action }}-{{ row.id }}">{% if icon %}<i class="bi {{ icon }} me-1" aria-hidden="true"></i>{% endif %}{{ label }}</button>
    </form>
{% endmacro %}

{# Decision buttons kept on the line of the review tab: an icon, the words
   in the tooltip and for screen readers. #}
{% macro icon_form(row, action, label, style, csrfToken, returnQuery, icon) %}
    <form method="post" action="{{ path('pricewatch_comparator_review', {id: row.id, action: action}) }}" class="d-inline">
        <input type="hidden" name="_token" value="{{ csrfToken }}">
        <input type="hidden" name="return" value="{{ returnQuery }}">
        <button type="submit" class="btn btn-sm {{ style }}" data-bs-toggle="tooltip" title="{{ label }}" aria-label="{{ label }}" data-testid="pw-{{ action }}-{{ row.id }}"><i class="bi {{ icon }}" aria-hidden="true"></i></button>
    </form>
{% endmacro %}

{% macro external(url, icon, label, testid) %}
    <a class="btn btn-sm btn-link px-1 py-0 text-body-secondary" href="{{ url }}" target="_blank" rel="noopener noreferrer nofollow" data-bs-toggle="tooltip" title="{{ label }}" aria-label="{{ label }}" data-testid="{{ testid }}"><i class="bi {{ icon }}" aria-hidden="true"></i></a>
{% endmacro %}

{% block content %}
<div class="container-fluid" data-testid="pricewatch-comparator-page">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
        <div>
            <h1 class="h3 mb-1">{{ 'Price comparator'|trans({}, 'pricewatch') }}</h1>
            <p class="text-muted mb-0">{{ 'Our prices against whitelisted competitors, for the same product in the same size. Prices include tax, shipping excluded.'|trans({}, 'pricewatch') }}</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" href="{{ path('pricewatch_watched') }}">{{ 'Watched products'|trans({}, 'pricewatch') }}</a>
            <a class="btn btn-outline-secondary" href="{{ path('pricewatch_competitors') }}">{{ 'Competitors'|trans({}, 'pricewatch') }}</a>
            <a class="btn btn-outline-secondary" href="{{ path('admin.module.configure', {module_code: 'PriceWatch'}) }}">{{ 'Settings'|trans({}, 'pricewatch') }}</a>
        </div>
    </div>

    <div class="row g-3 mb-3" data-testid="pw-summary">
        <div class="col-6 col-lg">
            <div class="card h-100"><div class="card-body py-2">
                <div class="small text-muted">{{ 'Offers compared'|trans({}, 'pricewatch') }}</div>
                <div class="fs-4 fw-semibold">{{ summary.compared }}</div>
            </div></div>
        </div>
        <div class="col-6 col-lg">
            <div class="card h-100 border-success-subtle"><div class="card-body py-2">
                <div class="small text-muted">{{ 'We are cheaper'|trans({}, 'pricewatch') }}</div>
                <div class="fs-4 fw-semibold text-success-emphasis" data-testid="pw-summary-we-are-cheaper">{{ summary.weAreCheaper }}</div>
            </div></div>
        </div>
        <div class="col-6 col-lg">
            <div class="card h-100 border-danger-subtle"><div class="card-body py-2">
                <div class="small text-muted">{{ 'We are dearer'|trans({}, 'pricewatch') }}</div>
                <div class="fs-4 fw-semibold text-danger-emphasis" data-testid="pw-summary-we-are-dearer">{{ summary.weAreDearer }}</div>
            </div></div>
        </div>
        <div class="col-6 col-lg">
            <div class="card h-100"><div class="card-body py-2">
                <div class="small text-muted">{{ 'Average gap'|trans({}, 'pricewatch') }}</div>
                <div class="fs-4 fw-semibold {{ summary.averagePosition == 'cheaper' ? 'text-success-emphasis' : (summary.averagePosition == 'dearer' ? 'text-danger-emphasis' : '') }}">{{ summary.averagePct ?? '–' }}</div>
            </div></div>
        </div>
        <div class="col-12 col-lg">
            <a class="card h-100 text-decoration-none {{ counts.review > 0 ? 'border-warning' : '' }}" href="{{ tabs[1].url }}" data-testid="pw-summary-review">
                <div class="card-body py-2">
                    <div class="small text-muted">{{ 'Waiting for your review'|trans({}, 'pricewatch') }}</div>
                    <div class="fs-4 fw-semibold text-body">{{ counts.review }}</div>
                </div>
            </a>
        </div>
    </div>

    {% include '@PriceWatchModule/backOffice/default-twig/price-watch/_run.html.twig' with {run: run, batches: batches, csrfToken: csrfToken} only %}
    {% include '@PriceWatchModule/backOffice/default-twig/price-watch/_usage.html.twig' with {usage: usage} only %}

    <form method="get" action="{{ path('pricewatch_comparator') }}" class="row g-2 align-items-end mb-3" data-testid="pw-filters">
        <input type="hidden" name="view" value="{{ view }}">
        {% if filters.sort %}<input type="hidden" name="sort" value="{{ filters.sort }}">{% endif %}
        <div class="col-12 col-md-4">
            <label class="form-label small fw-semibold" for="pw-q">{{ 'Product'|trans({}, 'pricewatch') }}</label>
            <input type="search" class="form-control form-control-sm" id="pw-q" name="q" value="{{ filters.search }}" placeholder="{{ 'Name or reference'|trans({}, 'pricewatch') }}">
        </div>
        <div class="col-12 col-sm-6 col-md-3">
            <label class="form-label small fw-semibold" for="pw-competitor">{{ 'Competitor'|trans({}, 'pricewatch') }}</label>
            <select class="form-select form-select-sm" id="pw-competitor" name="competitor">
                <option value="">{{ 'All whitelisted competitors'|trans({}, 'pricewatch') }}</option>
                {% for id, domain in competitors %}
                    <option value="{{ id }}" {% if filters.competitorId == id %}selected{% endif %}>{{ domain }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-12 col-sm-6 col-md-3">
            <div class="form-check mb-1">
                <input class="form-check-input" type="checkbox" id="pw-cheaper" name="cheaper" value="1" {% if filters.cheaperOnly %}checked{% endif %}>
                <label class="form-check-label small" for="pw-cheaper">{{ 'Only where we are dearer'|trans({}, 'pricewatch') }}</label>
            </div>
        </div>
        <div class="col-12 col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-sm btn-primary flex-grow-1">{{ 'Filter'|trans({}, 'pricewatch') }}</button>
            <a class="btn btn-sm btn-outline-secondary" href="{{ path('pricewatch_comparator', {view: view}) }}">{{ 'Reset'|trans({}, 'pricewatch') }}</a>
        </div>
    </form>

    <ul class="nav nav-tabs mb-2" data-testid="pw-tabs">
        {% for tab in tabs %}
            <li class="nav-item">
                <a class="nav-link {{ tab.active ? 'active' : '' }}" {% if tab.active %}aria-current="page"{% endif %} href="{{ tab.url }}" data-testid="pw-tab-{{ tab.view }}">
                    {{ ('view.' ~ tab.view)|trans({}, 'pricewatch') }}
                    <span class="badge {{ tab.view == 'review' and tab.count > 0 ? 'text-bg-warning' : 'text-bg-light border' }} ms-1">{{ tab.count }}</span>
                </a>
            </li>
        {% endfor %}
    </ul>

    <p class="small text-muted mb-2">{{ ('view.' ~ view ~ '.help')|trans({}, 'pricewatch') }}</p>

    {% if rows is empty %}
        <div class="alert alert-light border" data-testid="pw-empty">
            {% if competitors is empty %}
                {{ 'No competitor is whitelisted: nothing is compared yet.'|trans({}, 'pricewatch') }}
                <a href="{{ path('pricewatch_competitors') }}">{{ 'Manage competitors'|trans({}, 'pricewatch') }}</a>
            {% else %}
                {{ ('view.' ~ view ~ '.empty')|trans({}, 'pricewatch') }}
            {% endif %}
        </div>
    {% else %}
        {% set fifth = {gaps: 'Reliability', review: 'Why', pending: 'Reliability', excluded: 'Why'} %}
        <div class="table-responsive">
            <table class="table align-middle mb-2 pw-offers" data-testid="pw-offers">
                <thead>
                    <tr>
                        <th scope="col">{{ 'Product'|trans({}, 'pricewatch') }}</th>
                        <th scope="col">{{ 'Competitor'|trans({}, 'pricewatch') }}</th>
                        <th scope="col" class="text-end">{{ 'Their price / ours'|trans({}, 'pricewatch') }}</th>
                        <th scope="col" class="text-end" {% if sort.direction %}aria-sort="{{ sort.direction == 'ASC' ? 'ascending' : 'descending' }}"{% endif %}>
                            <a class="text-reset text-decoration-none text-nowrap" href="{{ sort.toggle }}" data-testid="pw-sort-gap" title="{{ sort.direction == 'ASC' ? 'Sort: we are cheapest first'|trans({}, 'pricewatch') : 'Sort: competitor cheapest first'|trans({}, 'pricewatch') }}">
                                {{ 'Gap'|trans({}, 'pricewatch') }}
                                <i class="bi {{ sort.direction == 'ASC' ? 'bi-sort-down-alt' : (sort.direction == 'DESC' ? 'bi-sort-up' : 'bi-arrow-down-up') }}" aria-hidden="true"></i>
                            </a>
                        </th>
                        <th scope="col">{{ fifth[view]|trans({}, 'pricewatch') }}</th>
                        <th scope="col" class="text-end"><span class="visually-hidden">{{ 'Details'|trans({}, 'pricewatch') }}</span></th>
                    </tr>
                </thead>
                <tbody>
                {% for row in rows %}
                    <tr class="pw-row" data-testid="pw-offer-{{ row.id }}">
                        {# max-width 0 lets the title shrink to the column and truncate. #}
                        <td style="width: 32%; max-width: 0; min-width: 15rem">
                            <div class="d-flex align-items-center gap-2">
                                {% if row.image %}
                                    <img src="{{ row.image }}" alt="" width="40" height="40" loading="lazy" referrerpolicy="no-referrer" class="rounded border flex-shrink-0 bg-white" style="object-fit: contain" data-testid="pw-image-{{ row.id }}">
                                {% else %}
                                    <span class="d-inline-flex align-items-center justify-content-center rounded border flex-shrink-0 bg-body-tertiary text-secondary" style="width: 40px; height: 40px" aria-hidden="true" data-testid="pw-image-{{ row.id }}"><i class="bi bi-image"></i></span>
                                {% endif %}
                                <div style="min-width: 0">
                                    {% if row.product.editUrl %}<a href="{{ row.product.editUrl }}" class="fw-semibold d-block text-truncate" title="{{ row.product.title }}">{{ row.product.title }}</a>{% else %}<span class="fw-semibold d-block text-truncate">{{ row.product.title }}</span>{% endif %}
                                    <div class="small text-muted text-truncate">{{ row.product.ref }}{% if row.product.size %} · {{ 'Size'|trans({}, 'pricewatch') }} <strong class="text-body">{{ row.product.size }}</strong>{% endif %}</div>
                                </div>
                            </div>
                        </td>
                        <td class="text-nowrap" data-testid="pw-links-{{ row.id }}">
                            <span class="fw-semibold">{{ row.competitor }}</span>
                            {% if row.links.product %}
                                {{ _self.external(row.links.product, 'bi-box-arrow-up-right', 'See the product on %site%'|trans({'%site%': row.competitor}, 'pricewatch'), 'pw-link-product-' ~ row.id) }}
                            {% elseif row.links.search %}
                                {{ _self.external(row.links.search, 'bi-search', 'Search on %site%'|trans({'%site%': row.competitor}, 'pricewatch'), 'pw-link-search-' ~ row.id) }}
                            {% endif %}
                            {% if row.links.google %}
                                {{ _self.external(row.links.google, 'bi-google', 'See every seller on Google Shopping'|trans({}, 'pricewatch'), 'pw-link-google-' ~ row.id) }}
                            {% endif %}
                        </td>
                        <td class="text-end text-nowrap">
                            <div class="fw-semibold text-body">{{ row.theirs ?? '–' }}</div>
                            <div class="small text-muted">{{ 'ours %price%'|trans({'%price%': row.ours ?? '–'}, 'pricewatch') }}</div>
                        </td>
                        <td class="text-end" style="width: 9rem" data-testid="pw-gap-{{ row.id }}" data-position="{{ row.position }}">{{ _self.gap(row) }}</td>
                        <td>
                            {% if view in ['review', 'excluded'] %}
                                {# To review: the reason the code sent it there. Excluded: the
                                   most telling cause, a price that does not compare, a human's
                                   decision, the question Jev said no to, then the reason. #}
                                {% set refused = row.confidence.gauges|filter(gauge => gauge.band == 'no')|first %}
                                {% set why = view == 'review' and row.reason ? ('reason.' ~ row.reason)|trans({}, 'pricewatch')
                                    : (row.exclusion ? ('exclusion.' ~ row.exclusion)|trans({}, 'pricewatch')
                                    : (row.state == 'rejected' and row.method == 'human' ? 'Excluded by hand by %who%'|trans({'%who%': row.reviewedBy ?: '?'}, 'pricewatch')
                                    : (refused ? ('refused.' ~ refused.question)|trans({}, 'pricewatch')
                                    : (row.reason ? ('reason.' ~ row.reason)|trans({}, 'pricewatch') : ('state.' ~ row.state)|trans({}, 'pricewatch'))))) %}
                                <div class="small text-muted text-truncate mb-1" style="max-width: 14rem" title="{{ why }}" data-testid="pw-why-{{ row.id }}">{{ why }}</div>
                            {% endif %}
                            {{ _self.trust(row) }}
                        </td>
                        <td class="text-end text-nowrap">
                            {% if view == 'review' %}
                                {% if row.actions.confirm %}{{ _self.icon_form(row, 'confirm', 'Confirm: same product, same size'|trans({}, 'pricewatch'), 'btn-success', csrfToken, returnQuery, 'bi-check-lg') }}{% endif %}
                                {% if row.actions.reject %}{{ _self.icon_form(row, 'reject', 'Exclude this offer'|trans({}, 'pricewatch'), 'btn-outline-danger', csrfToken, returnQuery, 'bi-x-lg') }}{% endif %}
                            {% endif %}
                            <button type="button" class="btn btn-sm btn-outline-secondary border-0 pw-toggle" data-bs-toggle="collapse" data-bs-target="#pw-detail-{{ row.id }}" aria-expanded="false" aria-controls="pw-detail-{{ row.id }}" aria-label="{{ 'Details'|trans({}, 'pricewatch') }}" data-testid="pw-toggle-{{ row.id }}"><i class="bi bi-chevron-down" aria-hidden="true"></i></button>
                        </td>
                    </tr>
                    <tr class="collapse pw-detail" id="pw-detail-{{ row.id }}" data-testid="pw-proof-{{ row.id }}">
                        <td colspan="6" class="bg-body-tertiary px-4 py-3 text-wrap">
                            <div class="row g-4 small">
                                <div class="col-12 col-xl-5">
                                    <div class="text-uppercase text-muted fw-semibold mb-2">{{ 'Competitor offer'|trans({}, 'pricewatch') }}</div>
                                    <dl class="row mb-0">
                                        <dt class="col-4 fw-normal text-muted">{{ 'Google card'|trans({}, 'pricewatch') }}</dt>
                                        <dd class="col-8 mb-1">{{ row.remoteTitle ?: '–' }}</dd>
                                        <dt class="col-4 fw-normal text-muted">{{ 'Seller listing'|trans({}, 'pricewatch') }}</dt>
                                        <dd class="col-8 mb-1">{{ row.remoteVariant ?: '–' }}</dd>
                                        <dt class="col-4 fw-normal text-muted">{{ 'Shipping'|trans({}, 'pricewatch') }}</dt>
                                        <dd class="col-8 mb-1">{{ row.shipping ? '+ ' ~ row.shipping : 'not given'|trans({}, 'pricewatch') }}</dd>
                                        <dt class="col-4 fw-normal text-muted">{{ 'Gap'|trans({}, 'pricewatch') }}</dt>
                                        <dd class="col-8 mb-1">{% if row.delta %}{{ row.delta }} : {{ ('position.' ~ row.position)|trans({}, 'pricewatch')|lower }}{% else %}–{% endif %}</dd>
                                        <dt class="col-4 fw-normal text-muted">{{ 'Last seen'|trans({}, 'pricewatch') }}</dt>
                                        <dd class="col-8 mb-1">{{ row.seenAt ?: '–' }}{% if row.searchedBy %} · {{ ('searched_by.' ~ row.searchedBy)|trans({}, 'pricewatch') }}{% endif %}</dd>
                                        <dt class="col-4 fw-normal text-muted">{{ 'Status'|trans({}, 'pricewatch') }}</dt>
                                        <dd class="col-8 mb-0">{{ _self.state(row) }}</dd>
                                    </dl>
                                </div>
                                <div class="col-12 col-md-6 col-xl-4">
                                    <div class="text-uppercase text-muted fw-semibold mb-2">{{ 'Jev checks'|trans({}, 'pricewatch') }}</div>
                                    {% set bars = {yes: 'bg-success', act: 'bg-success', review: 'bg-warning', no: 'bg-danger'} %}
                                    {% for gauge in row.confidence.gauges %}
                                        <div class="d-flex align-items-center gap-2 mb-1" title="{{ ('jev.' ~ gauge.question)|trans({}, 'pricewatch') }}">
                                            <span class="text-muted" style="width: 4rem">{{ ('gauge.' ~ gauge.question)|trans({}, 'pricewatch') }}</span>
                                            <div class="progress flex-grow-1" style="height: .4rem" role="progressbar" aria-valuenow="{{ gauge.percent }}" aria-valuemin="0" aria-valuemax="100" aria-label="{{ ('jev.' ~ gauge.question)|trans({}, 'pricewatch') }}">
                                                <div class="progress-bar {{ bars[gauge.band] ?? 'bg-secondary' }}" style="width: {{ gauge.percent }}%"></div>
                                            </div>
                                            <span class="text-nowrap text-end" style="width: 2.6rem">{{ gauge.percent }} %</span>
                                        </div>
                                        {% if gauge.choice %}<div class="text-muted mb-1" style="margin-left: 4.5rem">{{ ('price.' ~ gauge.choice)|trans({}, 'pricewatch') }}</div>{% endif %}
                                    {% else %}
                                        <div class="text-muted">{{ row.method == 'human' ? 'Decided by a human, without Jev.'|trans({}, 'pricewatch') : 'No Jev answer yet.'|trans({}, 'pricewatch') }}</div>
                                    {% endfor %}
                                </div>
                                <div class="col-12 col-md-6 col-xl-3">
                                    <div class="text-uppercase text-muted fw-semibold mb-2">{{ 'Links and decision'|trans({}, 'pricewatch') }}</div>
                                    <div class="d-flex flex-wrap gap-1 mb-2">
                                        {% if row.links.product %}<a class="btn btn-sm btn-outline-secondary" href="{{ row.links.product }}" target="_blank" rel="noopener noreferrer nofollow">{{ 'See the product'|trans({}, 'pricewatch') }} <i class="bi bi-box-arrow-up-right ms-1" aria-hidden="true"></i></a>{% endif %}
                                        {% if row.links.search %}<a class="btn btn-sm btn-outline-secondary" href="{{ row.links.search }}" target="_blank" rel="noopener noreferrer nofollow">{{ 'Search on the site'|trans({}, 'pricewatch') }} <i class="bi bi-search ms-1" aria-hidden="true"></i></a>{% endif %}
                                        {% if row.links.google %}<a class="btn btn-sm btn-outline-secondary" href="{{ row.links.google }}" target="_blank" rel="noopener noreferrer nofollow">Google Shopping <i class="bi bi-google ms-1" aria-hidden="true"></i></a>{% endif %}
                                    </div>
                                    <div class="d-flex flex-wrap gap-1">
                                        {% if view != 'review' and row.actions.confirm %}{{ _self.review_form(row, 'confirm', 'Confirm'|trans({}, 'pricewatch'), 'btn-success', csrfToken, returnQuery, 'bi-check-lg') }}{% endif %}
                                        {% if view != 'review' and row.actions.reject %}{{ _self.review_form(row, 'reject', 'Exclude'|trans({}, 'pricewatch'), 'btn-outline-danger', csrfToken, returnQuery, null) }}{% endif %}
                                        {% if row.actions.reopen and row.state != 'candidate' %}{{ _self.review_form(row, 'reopen', 'To review'|trans({}, 'pricewatch'), 'btn-link', csrfToken, returnQuery, null) }}{% endif %}
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        <script>
            (function () {
                // A click anywhere on a line opens its detail, except on what
                // already does something (links, buttons, forms).
                const table = document.querySelector('[data-testid="pw-offers"]');

                table?.addEventListener('click', (event) => {
                    if (event.target.closest('a, button, form, input, select, label, .pw-detail')) {
                        return;
                    }

                    event.target.closest('tr.pw-row')?.querySelector('.pw-toggle')?.click();
                });
            })();
        </script>

        {% if pagination.pages > 1 %}
            <nav class="d-flex justify-content-between align-items-center" aria-label="{{ 'Pages'|trans({}, 'pricewatch') }}">
                <span class="small text-muted">{{ 'Page %page% of %pages%'|trans({'%page%': pagination.page, '%pages%': pagination.pages}, 'pricewatch') }}</span>
                <div class="d-flex gap-2">
                    {% if pagination.previous %}<a class="btn btn-sm btn-outline-secondary" href="{{ pagination.previous }}">{{ 'Previous'|trans({}, 'pricewatch') }}</a>{% endif %}
                    {% if pagination.next %}<a class="btn btn-sm btn-outline-secondary" href="{{ pagination.next }}">{{ 'Next'|trans({}, 'pricewatch') }}</a>{% endif %}
                </div>
            </nav>
        {% endif %}
    {% endif %}
</div>
{% endblock %}
