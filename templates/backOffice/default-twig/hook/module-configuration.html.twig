{#
    Secret fields are write-only: they are always rendered empty. The badge
    says where the key comes from and when it was saved, never any part of it.
#}
{% macro secret_field(secret, label, help, testForm) %}
    <div class="mb-3" data-testid="pw-secret-{{ secret.field }}">
        <div class="d-flex align-items-center gap-2 mb-1">
            <label class="form-label mb-0 fw-semibold" for="pw-{{ secret.field }}">{{ label }}</label>
            {% if secret.source == 'environment' %}
                <span class="badge text-bg-secondary">{{ 'Set by the server environment'|trans({}, 'pricewatch') }}</span>
            {% elseif secret.source == 'admin' %}
                <span class="badge text-bg-success">{{ 'Saved'|trans({}, 'pricewatch') }}{% if secret.updatedAt %} {{ secret.updatedAt }}{% endif %}</span>
            {% elseif secret.source == 'unreadable' %}
                <span class="badge text-bg-danger">{{ 'Unreadable, enter it again'|trans({}, 'pricewatch') }}</span>
            {% else %}
                <span class="badge text-bg-warning">{{ 'Not set'|trans({}, 'pricewatch') }}</span>
            {% endif %}
        </div>
        <div class="input-group">
            <input type="password" class="form-control" id="pw-{{ secret.field }}" name="{{ secret.field }}"
                   autocomplete="new-password" spellcheck="false"
                   {% if secret.source == 'environment' %}disabled placeholder="{{ secret.environmentVariable }}"
                   {% elseif secret.source == 'admin' %}placeholder="{{ 'Leave empty to keep the saved key'|trans({}, 'pricewatch') }}"{% endif %}>
            {% if testForm %}
                <button type="submit" class="btn btn-outline-secondary" form="{{ testForm }}"
                        {% if secret.source in ['missing', 'unreadable'] %}disabled{% endif %}>{{ 'Test'|trans({}, 'pricewatch') }}</button>
            {% endif %}
        </div>
        {% if help %}<div class="form-text">{{ help }}</div>{% endif %}
        {% if secret.source in ['admin', 'unreadable'] %}
            <div class="form-check mt-1">
                <input class="form-check-input" type="checkbox" value="1" id="pw-{{ secret.field }}-clear" name="{{ secret.field }}_clear">
                <label class="form-check-label small" for="pw-{{ secret.field }}-clear">{{ 'Delete the saved key'|trans({}, 'pricewatch') }}</label>
            </div>
        {% endif %}
    </div>
{% endmacro %}

<div class="container-fluid px-0" data-testid="pricewatch-configuration">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h2 class="h4 mb-1">{{ 'Price watch settings'|trans({}, 'pricewatch') }}</h2>
            <p class="text-muted mb-0">{{ 'Keys are stored encrypted. A key defined in the server environment takes precedence and cannot be changed here.'|trans({}, 'pricewatch') }}</p>
        </div>
        <a class="btn btn-outline-primary" href="{{ path('pricewatch_competitors') }}">{{ 'Manage competitors'|trans({}, 'pricewatch') }}</a>
    </div>

    {% include '@PriceWatchModule/backOffice/default-twig/price-watch/_usage.html.twig' with {usage: usage, open: true} only %}

    <form id="pw-settings-form" method="post" action="{{ path('pricewatch_settings_save') }}">
        <input type="hidden" name="_token" value="{{ csrfToken }}">

        <div class="row g-3">
            <div class="col-12 col-xl-6">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">{{ 'Match checks'|trans({}, 'pricewatch') }}</span>
                        <span class="badge {{ jevReady ? 'text-bg-success' : 'text-bg-warning' }}">{{ jevReady ? 'Ready'|trans({}, 'pricewatch') : 'Not ready'|trans({}, 'pricewatch') }}</span>
                    </div>
                    <div class="card-body">
                        <p class="text-muted small">{{ 'Each competitor offer is checked: same product, same variant, comparable price.'|trans({}, 'pricewatch') }}</p>
                        <fieldset class="mb-3">
                            <legend class="form-label fw-semibold fs-6">{{ 'Checks reached through'|trans({}, 'pricewatch') }}</legend>
                            {% for provider in jevProviders %}
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="jev_provider" id="pw-jev-{{ provider }}" value="{{ provider }}" {% if provider == jevProvider %}checked{% endif %}>
                                    <label class="form-check-label" for="pw-jev-{{ provider }}">
                                        {{ provider == 'typesafe' ? 'TypeSafe, directly'|trans({}, 'pricewatch') : 'OpenRouter, with the OpenRouter key below'|trans({}, 'pricewatch') }}
                                    </label>
                                </div>
                            {% endfor %}
                        </fieldset>
                        {{ _self.secret_field(secrets.typesafe_api_key, 'TypeSafe API key'|trans({}, 'pricewatch'), null, 'pw-test-typesafe') }}
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-6">
                <div class="card h-100">
                    <div class="card-header fw-semibold">OpenRouter</div>
                    <div class="card-body">
                        <p class="text-muted small">{{ 'Used only by the match checks, when they go through OpenRouter.'|trans({}, 'pricewatch') }}</p>
                        {{ _self.secret_field(secrets.openrouter_api_key, 'OpenRouter API key'|trans({}, 'pricewatch'), null, 'pw-test-openrouter') }}
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="alert alert-info mb-0" data-testid="pw-services-notice">
                    {{ 'The match checks (TypeSafe or OpenRouter) and the Google Shopping searches (DataForSEO) are external services, run outside the European Union or where the processing is not established. They receive product titles, sizes, prices and seller names: no personal data. Their cost counts in the AI consumption of the shop, and the monthly budget set there for each use applies to them.'|trans({}, 'pricewatch') }}
                </div>
            </div>

            <div class="col-12">
                <div class="card">
                    <div class="card-header fw-semibold">{{ 'Suggestions'|trans({}, 'pricewatch') }}</div>
                    <div class="card-body">
                        <p class="text-muted small">{{ 'Each family gets lines in proportion to its revenue. Tick the families that have no equivalent at competitors: they are never suggested.'|trans({}, 'pricewatch') }}</p>
                        <fieldset data-testid="pw-excluded-families">
                            <legend class="form-label fw-semibold fs-6">{{ 'Families left out of the suggestions'|trans({}, 'pricewatch') }}</legend>
                            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-1">
                                {% for id, title in families %}
                                    <div class="col">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="excluded_families[]" value="{{ id }}" id="pw-family-{{ id }}" {% if id in excludedFamilies %}checked{% endif %}>
                                            <label class="form-check-label" for="pw-family-{{ id }}">{{ title }}</label>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </fieldset>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="card">
                    <div class="card-header fw-semibold">{{ 'Price proposals'|trans({}, 'pricewatch') }}</div>
                    <div class="card-body">
                        <div class="row g-3 align-items-end">
                            <div class="col-12 col-md-4 col-xl-3">
                                <label class="form-label fw-semibold" for="pw-minimum-margin">{{ 'Minimum margin'|trans({}, 'pricewatch') }}</label>
                                <div class="input-group">
                                    <input type="text" inputmode="decimal" class="form-control" id="pw-minimum-margin" name="minimum_margin_pct" value="{{ minimumMarginPct }}" data-testid="pw-minimum-margin">
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>
                            <div class="col-12 col-md-8 col-xl-9">
                                <p class="text-muted small mb-0">{{ 'proposals.settings.help'|trans({}, 'pricewatch') }}</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="card" data-testid="pw-schedule-settings">
                    <div class="card-header fw-semibold">{{ 'Scheduled passes'|trans({}, 'pricewatch') }}</div>
                    <div class="card-body">
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" value="1" id="pw-schedule-enabled" name="schedule_enabled" {% if schedule.enabled %}checked{% endif %} data-testid="pw-schedule-enabled">
                            <label class="form-check-label fw-semibold" for="pw-schedule-enabled">{{ 'Read the watched products automatically, by tier'|trans({}, 'pricewatch') }}</label>
                        </div>
                        <p class="text-muted small">{{ 'schedule.settings.help'|trans({}, 'pricewatch') }}</p>
                        <div class="row g-3 align-items-end">
                            {% for tier, row in schedule.tiers %}
                                <div class="col-12 col-md-4 col-xl-2">
                                    <label class="form-label fw-semibold" for="pw-schedule-days-{{ tier }}">{{ 'schedule.tier.label'|trans({'%tier%': ('tier.' ~ tier)|trans({}, 'pricewatch')}, 'pricewatch') }}</label>
                                    <div class="input-group flex-nowrap">
                                        <input type="number" min="1" max="{{ schedule.maxDays }}" step="1" class="form-control" id="pw-schedule-days-{{ tier }}" name="schedule_days_{{ tier }}" value="{{ row.days }}" data-testid="pw-schedule-days-{{ tier }}">
                                        <span class="input-group-text">{{ 'days'|trans({}, 'pricewatch') }}</span>
                                    </div>
                                    <div class="small text-muted mt-1">{{ 'schedule.tier.products'|trans({'%count%': row.products}, 'pricewatch') }}</div>
                                </div>
                            {% endfor %}
                            <div class="col-12 col-md-6 col-xl-3">
                                <label class="form-label fw-semibold" for="pw-schedule-start">{{ 'Hours'|trans({}, 'pricewatch') }}</label>
                                <div class="input-group">
                                    <span class="input-group-text">{{ 'from'|trans({}, 'pricewatch') }}</span>
                                    <select class="form-select" id="pw-schedule-start" name="schedule_start_hour" data-testid="pw-schedule-start">
                                        {% for hour in 0..23 %}<option value="{{ hour }}" {% if hour == schedule.startHour %}selected{% endif %}>{{ hour }} h</option>{% endfor %}
                                    </select>
                                    <span class="input-group-text">{{ 'to'|trans({}, 'pricewatch') }}</span>
                                    <select class="form-select" id="pw-schedule-end" name="schedule_end_hour" data-testid="pw-schedule-end" aria-label="{{ 'End hour'|trans({}, 'pricewatch') }}">
                                        {% for hour in 0..23 %}<option value="{{ hour }}" {% if hour == schedule.endHour %}selected{% endif %}>{{ hour }} h</option>{% endfor %}
                                    </select>
                                </div>
                            </div>
                            <div class="col-12 col-md-6 col-xl-3">
                                <label class="form-label fw-semibold" for="pw-schedule-max">{{ 'Variants per pass'|trans({}, 'pricewatch') }}</label>
                                <input type="number" min="1" max="{{ schedule.maxVariantsLimit }}" step="1" class="form-control" id="pw-schedule-max" name="schedule_max_variants" value="{{ schedule.maxVariants }}" data-testid="pw-schedule-max">
                            </div>
                        </div>
                        <ul class="small text-muted mt-3 mb-0" data-testid="pw-schedule-status">
                            <li>{{ 'schedule.status.due'|trans({'%count%': schedule.dueNow, '%batch%': schedule.nextBatch}, 'pricewatch') }}</li>
                            <li>{{ 'schedule.status.monthly'|trans({'%cost%': schedule.monthlyCost}, 'pricewatch') }}</li>
                            <li>
                                {% if schedule.lastPass %}
                                    {{ 'schedule.status.last'|trans({'%at%': schedule.lastPass.at, '%products%': schedule.lastPass.products, '%variants%': schedule.lastPass.variants, '%cost%': schedule.lastPass.cost}, 'pricewatch') }}
                                {% else %}
                                    {{ 'No scheduled pass yet.'|trans({}, 'pricewatch') }}
                                {% endif %}
                            </li>
                            <li>{{ 'schedule.status.cron'|trans({}, 'pricewatch') }} <code>{{ schedule.cronLine }}</code></li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="card">
                    <div class="card-header fw-semibold">DataForSEO</div>
                    <div class="card-body">
                        <p class="text-muted small">{{ 'Source of competitor prices through Google Shopping.'|trans({}, 'pricewatch') }}</p>
                        <div class="row g-3">
                            <div class="col-12 col-lg-6">
                                <label class="form-label fw-semibold" for="pw-dataforseo-login">{{ 'Login'|trans({}, 'pricewatch') }}</label>
                                <input type="text" class="form-control" id="pw-dataforseo-login" name="dataforseo_login" autocomplete="off" spellcheck="false"
                                       value="{{ dataforseoLogin }}" {% if dataforseoLoginFromEnvironment %}disabled placeholder="DATAFORSEO_USERNAME"{% endif %}>
                            </div>
                            <div class="col-12 col-lg-6">
                                {{ _self.secret_field(secrets.dataforseo_password, 'Password'|trans({}, 'pricewatch'), null, 'pw-test-dataforseo') }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-3 d-flex align-items-center gap-3">
            <button type="submit" class="btn btn-primary">{{ 'Save'|trans({}, 'pricewatch') }}</button>
            <span class="small text-muted">{{ 'The Test buttons check the saved key: save a newly typed key first.'|trans({}, 'pricewatch') }}</span>
        </div>
    </form>

    {# Separate forms: HTML forms cannot nest, the buttons above point here through their form attribute. #}
    {% for service in ['openrouter', 'typesafe', 'dataforseo'] %}
        <form id="pw-test-{{ service }}" method="post" action="{{ path('pricewatch_settings_test', {service: service}) }}" class="d-none">
            <input type="hidden" name="_token" value="{{ csrfToken }}">
        </form>
    {% endfor %}
</div>
